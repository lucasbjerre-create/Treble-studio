{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "exchange-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Local dev / default. Points at the one real D1 database and R2 bucket
	// created 2026-10-23 (npx wrangler d1 create / r2 bucket create).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "exchange-site-db",
			"database_id": "3f689de0-1fe5-4f87-8d88-fe3739896015"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "exchange-site-media"
		}
	],
	"env": {
		// No separate preview D1/R2 resources exist yet. These placeholders
		// stay until a real preview database and bucket are created - swap
		// them in then, the same way production was wired up below.
		"preview": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "exchange-site-db-preview",
					"database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "exchange-site-media-preview-replace-me"
				}
			]
		},
		"production": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "exchange-site-db",
					"database_id": "3f689de0-1fe5-4f87-8d88-fe3739896015"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "exchange-site-media"
				}
			]
		}
	}
}
