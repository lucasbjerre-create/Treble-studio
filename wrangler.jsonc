{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "exchange-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Local dev binding. database_id is a placeholder: wrangler dev keys its
	// local SQLite file off this string, so it works before any real D1
	// database exists. Remote commands (db:migrate:remote, deploy) will fail
	// until this is replaced with the id from `npx wrangler d1 create`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "exchange-site-db",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "exchange-site-media-replace-me"
		}
	],
	"env": {
		"preview": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "exchange-site-db-preview",
					"database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "exchange-site-media-preview-replace-me"
				}
			]
		},
		"production": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "exchange-site-db",
					"database_id": "REPLACE_WITH_D1_DATABASE_ID"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "exchange-site-media-replace-me"
				}
			]
		}
	}
}
