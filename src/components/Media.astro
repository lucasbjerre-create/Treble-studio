---
import { publicMediaUrl } from '../lib/mediaUrl';

interface Props {
	kind: 'photo' | 'clip' | 'audio' | 'pdf';
	keyThumb: string | null;
	keyDisplay: string | null;
	keyLarge: string | null;
	posterKey: string | null;
	width: number | null;
	height: number | null;
	caption: string | null;
	altText: string | null;
	/** Pre-resolved "With Anna, Erik" line, already translated by the caller - this component stays i18n-unaware, same as caption/altText. */
	peopleNote?: string | null;
}

const { kind, keyDisplay, keyLarge, posterKey, width, height, caption, altText, peopleNote } = Astro.props;

// A real upload's key_* is a bare R2 object key, resolved through the
// viewer-checked /api/media route (src/worker/api/media.ts); a fixture's is
// already a full /fixtures/ path and publicMediaUrl leaves it alone.
const displayUrl = keyDisplay ? publicMediaUrl(keyDisplay) : null;
const largeUrl = keyLarge ? publicMediaUrl(keyLarge) : displayUrl;
const posterUrl = posterKey ? publicMediaUrl(posterKey) : undefined;
const aspectRatio = width && height ? `${width} / ${height}` : '4 / 3';
---

<figure class="media" style={`aspect-ratio: ${aspectRatio}`}>
	{
		kind === 'photo' && displayUrl && (
			<img
				class="photo"
				src={displayUrl}
				srcset={`${displayUrl} 480w, ${displayUrl} 1280w, ${largeUrl} 2048w`}
				sizes="(min-width: 768px) 60vw, 100vw"
				alt={altText ?? ''}
				loading="lazy"
			/>
		)
	}
	{
		kind === 'clip' && displayUrl && (
			// Muted by default, native controls only - no autoplay, no sound
			// unless the viewer starts it (spec section 6).
			<video src={displayUrl} poster={posterUrl} muted playsinline controls />
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
	{peopleNote && <p class="people-note">{peopleNote}</p>}
</figure>

<style>
	.media {
		width: 100%;
		margin: 0;
		background: var(--color-surface-sunken);
		display: flex;
		flex-direction: column;
	}

	.media img,
	.media video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	figcaption {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text-muted);
		padding: var(--space-2) 0 0;
	}

	.people-note {
		font-family: var(--font-sans);
		font-size: var(--text-micro);
		color: var(--color-text-muted);
		font-style: italic;
		margin: 0;
		padding: var(--space-1) 0 0;
	}
</style>
