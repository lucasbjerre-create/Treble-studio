---
import Media from '../Media.astro';
import type { Locale } from '../../i18n/t';
import type { EntryForDisplay, MediaForDisplay } from '../../lib/composition';
import { formatEntryDate } from '../../lib/entryDate';
import { paragraphsFrom } from '../../lib/text';

interface Props {
	entry: EntryForDisplay;
	media: MediaForDisplay[];
	lang: Locale;
}

const { entry, media, lang } = Astro.props;
const paragraphs = paragraphsFrom(entry.bodyMd);
---

<article class="photo-sequence">
	<p class="meta"><time datetime={entry.occurredAt}>{formatEntryDate(entry.occurredAt, entry.timezone, lang)}</time></p>
	<h1 class="title">{entry.title}</h1>
	{entry.dek && <p class="dek">{entry.dek}</p>}
	<div class="sequence">
		{
			media.map((m) => (
				<Media
					kind={m.kind}
					keyThumb={m.keyThumb}
					keyDisplay={m.keyDisplay}
					keyLarge={m.keyLarge}
					posterKey={m.posterKey}
					width={m.width}
					height={m.height}
					caption={m.caption}
					altText={m.altText}
					peopleNote={m.peopleNote}
				/>
			))
		}
	</div>
	{paragraphs.map((p) => <p class="body">{p}</p>)}
	{entry.translationNote && <p class="translation-note">{entry.translationNote}</p>}
</article>

<style>
	.photo-sequence {
		max-width: 44rem;
	}

	/* The same date line in all four compositions, matching the journal page's. */
	.meta {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-2);
	}

	.title {
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		margin: 0 0 var(--space-2);
	}

	.dek {
		font-family: var(--font-sans);
		font-size: var(--text-body);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-4);
	}

	.sequence {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin: 0 0 var(--space-4);
	}

	.body {
		font-family: var(--font-serif);
		font-size: var(--text-body);
		line-height: var(--leading-body);
		margin: 0 0 var(--space-4);
	}

	.translation-note {
		font-family: var(--font-sans);
		font-size: var(--text-micro);
		color: var(--color-text-muted);
		font-style: italic;
	}
</style>
