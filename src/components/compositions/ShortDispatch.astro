---
import Media from '../Media.astro';
import type { Locale } from '../../i18n/t';
import type { EntryForDisplay, MediaForDisplay } from '../../lib/composition';
import { formatEntryDate } from '../../lib/entryDate';
import { paragraphsFrom } from '../../lib/text';

interface Props {
	entry: EntryForDisplay;
	media: MediaForDisplay[];
	lang: Locale;
}

const { entry, media, lang } = Astro.props;
const paragraphs = paragraphsFrom(entry.bodyMd);
const firstMedia = media[0];
---

<article class="short-dispatch">
	<p class="meta"><time datetime={entry.occurredAt}>{formatEntryDate(entry.occurredAt, entry.timezone, lang)}</time></p>
	<h1 class="title">{entry.title}</h1>
	{entry.dek && <p class="dek">{entry.dek}</p>}
	{paragraphs.map((p) => <p class="body">{p}</p>)}
	{
		firstMedia && (
			<Media
				kind={firstMedia.kind}
				keyThumb={firstMedia.keyThumb}
				keyDisplay={firstMedia.keyDisplay}
				keyLarge={firstMedia.keyLarge}
				posterKey={firstMedia.posterKey}
				width={firstMedia.width}
				height={firstMedia.height}
				caption={firstMedia.caption}
				altText={firstMedia.altText}
				peopleNote={firstMedia.peopleNote}
			/>
		)
	}
	{entry.translationNote && <p class="translation-note">{entry.translationNote}</p>}
</article>

<style>
	.short-dispatch {
		max-width: 34rem;
	}

	/* The same date line in all four compositions, matching the journal page's. */
	.meta {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-2);
	}

	.title {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-eyebrow);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-2);
	}

	.dek {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-3);
	}

	.body {
		font-family: var(--font-serif);
		font-size: var(--text-body-lg);
		line-height: 1.5;
		margin: 0 0 var(--space-4);
	}

	.translation-note {
		font-family: var(--font-sans);
		font-size: var(--text-micro);
		color: var(--color-text-muted);
		font-style: italic;
	}
</style>
