---
import StudioLayout from '../../../../layouts/StudioLayout.astro';
import { getDb } from '../../../../db/client';
import { getEntryById, getPersonByEmail } from '../../../../db/queries';

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) {
	return new Response('Not found', { status: 404 });
}

const db = getDb();
const person = await getPersonByEmail(db, Astro.locals.accessEmail);
if (!person) {
	return new Response('No person record matches this account', { status: 403 });
}

const entry = await getEntryById(db, id);
if (!entry || entry.personId !== person.id || entry.status !== 'published') {
	return new Response('Not found', { status: 404 });
}
---

<StudioLayout title="Published">
	<main class="studio">
		<p class="eyebrow">Published</p>
		<h1>{entry.title}</h1>
		<p class="hint">It's live now, subject to its audience and publish delay.</p>
		<div class="actions">
			<a class="button" href="/studio">Back to Entries</a>
			<a class="link" href={`/studio/entries/${entry.id}`}>Keep editing this entry</a>
		</div>
	</main>
</StudioLayout>

<style>
	.studio {
		max-width: 32rem;
		margin: 0 auto;
		padding: var(--space-12) var(--grid-margin);
		font-family: var(--font-sans);
		text-align: center;
	}

	.eyebrow {
		color: var(--color-success);
		font-size: var(--text-small);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0 0 var(--space-2);
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		margin: 0 0 var(--space-3);
	}

	.hint {
		color: var(--color-text-muted);
		margin: 0 0 var(--space-6);
	}

	.actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-min);
		padding: 0 var(--space-4);
		background: var(--color-primary);
		color: var(--color-on-primary);
		border-radius: var(--radius-xs);
		text-decoration: none;
	}

	.link {
		color: var(--color-link);
		font-size: var(--text-small);
	}
</style>
