---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { getDb } from '../../db/client';
import { getPersonByEmail, listEntriesForViewer } from '../../db/queries';

const db = getDb();
const person = await getPersonByEmail(db, Astro.locals.accessEmail);
if (!person) {
	return new Response('No person record matches this account', { status: 403 });
}

const now = new Date().toISOString();
const entries = await listEntriesForViewer(db, 'studio', now, { personId: person.id });
---

<StudioLayout title="Entries">
	<main class="studio">
		<div class="top-row">
			<h1>Entries</h1>
			<div class="top-row-actions">
				<a class="link" href="/studio/followers">Followers</a>
				<a class="button" href="/studio/entries/new">New entry</a>
			</div>
		</div>

		{
			entries.length === 0 ? (
				<p>Nothing yet.</p>
			) : (
				<ul class="entry-list">
					{entries.map((entry) => (
						<li>
							<a href={`/studio/entries/${entry.id}`}>
								<span class="status" data-status={entry.status}>
									{entry.status}
								</span>
								<span class="title">{entry.title}</span>
								<span class="date">{entry.occurredAt.slice(0, 10)}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</main>
</StudioLayout>

<style>
	.studio {
		max-width: 40rem;
		margin: 0 auto;
		padding: var(--space-6) var(--grid-margin) var(--space-12);
		font-family: var(--font-sans);
	}

	.top-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-6);
	}

	.top-row-actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.link {
		color: var(--color-link);
		font-size: var(--text-small);
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		margin: 0;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-min);
		padding: 0 var(--space-4);
		background: var(--color-primary);
		color: var(--color-on-primary);
		border-radius: var(--radius-xs);
		text-decoration: none;
	}

	.entry-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.entry-list a {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: var(--touch-min);
		padding: var(--space-2) 0;
		border-top: var(--border-hairline);
		color: var(--color-text);
		text-decoration: none;
	}

	.status {
		font-size: var(--text-micro);
		text-transform: uppercase;
		color: var(--color-text-muted);
		min-width: 4.5rem;
	}

	.status[data-status='published'] {
		color: var(--color-public);
	}

	.title {
		flex: 1;
	}

	.date {
		font-size: var(--text-small);
		color: var(--color-text-muted);
	}
</style>
