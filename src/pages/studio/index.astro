---
import EntryList from '../../components/EntryList';
import StudioLayout from '../../layouts/StudioLayout.astro';
import { getDb } from '../../db/client';
import { getPersonByEmail, listEntrySummariesForPerson } from '../../db/queries';
import { sweepStaleDrafts } from '../../worker/entryDeletion';

const db = getDb();
const person = await getPersonByEmail(db, Astro.locals.accessEmail);
if (!person) {
	return new Response('No person record matches this account', { status: 403 });
}

const now = new Date().toISOString();
// Lazy auto-delete of drafts older than DRAFT_EXPIRY_DAYS, before the list
// below is even read - see entryDeletion.ts.
await sweepStaleDrafts(db, person.id, now);
const entries = await listEntrySummariesForPerson(db, person.id);
---

<StudioLayout title="Entries">
	<main class="studio">
		<div class="top-row">
			<h1>Entries</h1>
			<div class="top-row-actions">
				<a class="link" href="/studio/followers">Followers</a>
				<a class="link" href="/studio/entries/bulk">Bulk upload</a>
				<a class="button" href="/studio/entries/new">New entry</a>
			</div>
		</div>

		<EntryList client:only="react" entries={entries} />
	</main>
</StudioLayout>

<style>
	.studio {
		max-width: 40rem;
		margin: 0 auto;
		padding: var(--space-6) var(--grid-margin) var(--space-12);
		font-family: var(--font-sans);
	}

	.top-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-6);
	}

	.top-row-actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.link {
		color: var(--color-link);
		font-size: var(--text-small);
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		margin: 0;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-min);
		padding: 0 var(--space-4);
		background: var(--color-primary);
		color: var(--color-on-primary);
		border-radius: var(--radius-xs);
		text-decoration: none;
	}

</style>
