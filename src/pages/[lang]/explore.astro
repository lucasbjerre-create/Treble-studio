---
import { PRIMARY_PERSON_SLUG } from '../../config/site';
import { isLocale, type Locale } from '../../i18n/t';

const { lang: rawLang } = Astro.params;
if (!rawLang || !isLocale(rawLang)) {
	return Astro.rewrite('/404');
}
const lang = rawLang as Locale;

// The nav/homepage links here don't know "whose" explore page to send a
// visitor to yet - that chooser is docs/BUILD_PLAN.md's "Second trebler"
// milestone. Until then, redirect to the one person's own explore page.
return Astro.redirect(`/${lang}/${PRIMARY_PERSON_SLUG}/explore`);
---
