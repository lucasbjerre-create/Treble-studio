---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Media from '../../components/Media.astro';
import { getDb } from '../../db/client';
import {
	getAdjacentEntries,
	getEntryBySlugForViewer,
	getEntryTranslation,
	getPersonBySlug,
	getPlaceById,
	listEntriesForViewer,
	listMediaForEntry,
	listPeopleNamesByMedia,
	resolveViewerForPerson
} from '../../db/queries';
import { PRIMARY_PERSON_SLUG } from '../../config/site';
import { isLocale, t, type Locale } from '../../i18n/t';
import type { MediaForDisplay } from '../../lib/composition';
import { formatEntryDate } from '../../lib/entryDate';
import { peopleNoteFor } from '../../lib/peopleNote';
import { resolveEntryText } from '../../lib/translation';
import { paragraphsFrom } from '../../lib/text';

const { lang: rawLang } = Astro.params;
if (!rawLang || !isLocale(rawLang)) {
	return Astro.rewrite('/404');
}
const lang = rawLang as Locale;
const dict = t(lang);

const db = getDb();
const now = new Date().toISOString();

const person = await getPersonBySlug(db, 'public', PRIMARY_PERSON_SLUG);
if (!person) {
	return Astro.rewrite('/404');
}

const viewer = await resolveViewerForPerson(db, Astro.locals.viewerEmail, person.id);

const entrySlugParam = Astro.url.searchParams.get('entry');

const entry = entrySlugParam
	? await getEntryBySlugForViewer(db, viewer, person.slug, entrySlugParam, now)
	: (await listEntriesForViewer(db, viewer, now, { personId: person.id }))[0];

if (entrySlugParam && !entry) {
	return Astro.rewrite('/404');
}

let media: MediaForDisplay[] = [];
let adjacent: { prev?: { slug: string }; next?: { slug: string } } = {};
let resolvedTitle = '';
let resolvedDek: string | null = null;
let paragraphs: string[] = [];
let translationNote: string | null = null;
let placeLabel: string | null = null;

if (entry) {
	const [translation, mediaRows, adjacentRows, place] = await Promise.all([
		getEntryTranslation(db, entry.id, lang),
		listMediaForEntry(db, viewer, entry.id, now),
		getAdjacentEntries(db, viewer, entry.personId, entry.occurredAt, now),
		entry.placeId ? getPlaceById(db, viewer, entry.placeId) : Promise.resolve(undefined)
	]);

	const namesByMedia = await listPeopleNamesByMedia(
		db,
		mediaRows.map((m) => m.id)
	);
	media = mediaRows.map((m) => ({ ...m, peopleNote: peopleNoteFor(namesByMedia.get(m.id) ?? [], dict.media.with) }));
	adjacent = adjacentRows;
	placeLabel = place?.label ?? null;

	const resolved = resolveEntryText(
		{ originalLang: entry.originalLang, title: entry.title, dek: entry.dek, bodyMd: entry.bodyMd },
		translation,
		lang
	);
	resolvedTitle = resolved.title;
	resolvedDek = resolved.dek;
	paragraphs = paragraphsFrom(resolved.bodyMd);
	translationNote = resolved.isFallback ? dict.entry.translationNote : null;
}

const altPath = `/${lang === 'en' ? 'da' : 'en'}/journal${entry ? `?entry=${entry.slug}` : ''}`;
---

<BaseLayout lang={lang} title={`${dict.journal.title} - ${dict.siteTitle}`} altPath={altPath}>
	<main class="journal">
		{
			entry ? (
				<>
					<p class="meta">
						{placeLabel && <span class="place">{placeLabel}</span>}
						<span class="when">
							{placeLabel && <span aria-hidden="true">·</span>}
							<time datetime={entry.occurredAt}>{formatEntryDate(entry.occurredAt, entry.timezone, lang)}</time>
						</span>
					</p>
					<h1>{resolvedTitle}</h1>
					{resolvedDek && <p class="dek">{resolvedDek}</p>}
					{paragraphs.map((p) => (
						<p class="body">{p}</p>
					))}
					{media.map((m) => (
						<Media
							kind={m.kind}
							keyThumb={m.keyThumb}
							keyDisplay={m.keyDisplay}
							keyLarge={m.keyLarge}
							posterKey={m.posterKey}
							width={m.width}
							height={m.height}
							caption={m.caption}
							altText={m.altText}
							peopleNote={m.peopleNote}
						/>
					))}
					{translationNote && <p class="translation-note">{translationNote}</p>}
				</>
			) : (
				<p>{dict.common.noEntries}</p>
			)
		}

		<nav class="pager">
			{adjacent.prev ? <a href={`/${lang}/journal?entry=${adjacent.prev.slug}`}>{dict.journal.older}</a> : <span />}
			{adjacent.next ? <a href={`/${lang}/journal?entry=${adjacent.next.slug}`}>{dict.journal.newer}</a> : <span />}
		</nav>
	</main>
</BaseLayout>

<style>
	.journal {
		max-width: 34rem;
		margin: 0 auto;
		padding: var(--space-6) var(--grid-margin) var(--space-12);
		font-size: var(--text-body-lg);
	}

	/* Place, a middle dot, then the date - or the date alone when the entry
	   has no place. Each part is its own flex item, so a long place name
	   wraps inside its own box and "· 30 Oct 2026" stays in one piece. */
	.meta {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-2);
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-2);
	}

	.place {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.when {
		display: flex;
		gap: var(--space-2);
		white-space: nowrap;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		margin: 0 0 var(--space-3);
	}

	.dek {
		font-family: var(--font-sans);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-4);
	}

	.body {
		font-family: var(--font-serif);
		line-height: var(--leading-body);
		margin: 0 0 var(--space-4);
	}

	.translation-note {
		font-family: var(--font-sans);
		font-size: var(--text-micro);
		color: var(--color-text-muted);
		font-style: italic;
	}

	.pager {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-8);
		padding-top: var(--space-4);
		border-top: var(--border-hairline);
	}

	.pager a {
		font-family: var(--font-sans);
		font-size: var(--text-body-lg);
		color: var(--color-text);
		text-decoration: none;
		min-height: var(--touch-min);
		min-width: var(--touch-min);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--color-border);
	}

	.pager a:hover {
		color: var(--color-link);
		border-color: var(--color-link);
	}
</style>
