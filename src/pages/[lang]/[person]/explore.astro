---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TimelineExplorer from '../../../components/TimelineExplorer.tsx';
import { getDb } from '../../../db/client';
import {
	getPersonBySlug,
	listEntriesForViewer,
	listEntryTranslations,
	listLegsForViewer,
	listMediaForEntry,
	listPlacesForViewer,
	resolveViewerForPerson
} from '../../../db/queries';
import { isLocale, t, type Locale } from '../../../i18n/t';
import { formatEntryDate, formatEntryDay } from '../../../lib/entryDate';
import { publicMediaUrl } from '../../../lib/mediaUrl';
import { resolveEntryText } from '../../../lib/translation';

const { lang: rawLang, person: personSlug } = Astro.params;
if (!rawLang || !isLocale(rawLang) || !personSlug) {
	return Astro.rewrite('/404');
}
const lang = rawLang as Locale;
const dict = t(lang);

const db = getDb();
const now = new Date().toISOString();

const person = await getPersonBySlug(db, 'public', personSlug);
if (!person) {
	return Astro.rewrite('/404');
}

const viewer = await resolveViewerForPerson(db, Astro.locals.viewerEmail, person.id);

const entries = await listEntriesForViewer(db, viewer, now, { personId: person.id });
const legs = await listLegsForViewer(db, viewer, now);
const places = await listPlacesForViewer(db, viewer);

const translations = await listEntryTranslations(
	db,
	entries.map((e) => e.id),
	lang
);

// One pass per entry, reused for both the journal-card list below and the
// map's marker card (TimelineExplorer's popup on the active entry) - a
// second listMediaForEntry round just to get the same thumbnail again would
// be wasted work.
const entryExtras = await Promise.all(
	entries.map(async (entry) => {
		const resolved = resolveEntryText(
			{ originalLang: entry.originalLang, title: entry.title, dek: entry.dek, bodyMd: entry.bodyMd },
			translations.get(entry.id),
			lang
		);
		const media = await listMediaForEntry(db, viewer, entry.id, now);
		return {
			title: resolved.title,
			dek: resolved.dek,
			thumb: media[0]?.keyThumb ? publicMediaUrl(media[0].keyThumb) : null,
			thumbAlt: media[0]?.altText ?? '',
			thumbWidth: media[0]?.width ?? null,
			thumbHeight: media[0]?.height ?? null,
			// Formatted once, here, in the entry's own timezone - the journal
			// cards, the phone bar and the slider all print these same strings,
			// so they cannot disagree about which day an entry happened on.
			dateLabel: formatEntryDate(entry.occurredAt, entry.timezone, lang),
			dayLabel: formatEntryDay(entry.occurredAt, entry.timezone, lang)
		};
	})
);

const cards = entries.map((entry, i) => ({
	id: entry.id,
	slug: entry.slug,
	occurredAt: entry.occurredAt,
	...entryExtras[i]
}));

// timeline.ts is multi-person-ready, but this page still shows one person at
// a time - only this person's entries/legs are passed in. personId is
// threaded through because TimelineEntry/TimelineLeg now require it.
const explorerEntries = entries.map((e, i) => ({
	id: e.id,
	personId: e.personId,
	slug: e.slug,
	occurredAt: e.occurredAt,
	chapterId: e.chapterId,
	placeId: e.placeId,
	title: entryExtras[i].title,
	thumb: entryExtras[i].thumb,
	thumbAlt: entryExtras[i].thumbAlt,
	thumbWidth: entryExtras[i].thumbWidth,
	thumbHeight: entryExtras[i].thumbHeight,
	dateLabel: entryExtras[i].dateLabel,
	dayLabel: entryExtras[i].dayLabel
}));

const explorerLegs = legs.map((l) => ({
	id: l.id,
	personId: l.personId,
	fromPlaceId: l.fromPlaceId,
	toPlaceId: l.toPlaceId,
	startsAt: l.startsAt,
	endsAt: l.endsAt,
	mode: l.mode
}));

const explorerPlaces = places.map((p) => ({ id: p.id, label: p.label, latPublic: p.latPublic, lonPublic: p.lonPublic }));

// Only this page's own person for now (same single-person scope as
// explorerEntries/explorerLegs above) - keyed by id so TimelineExplorer can
// look up any personId it encounters, ready for when more than one person's
// entries are passed in together.
const explorerPeople = { [person.id]: { displayName: person.displayName, seat: person.seat } };
---

<BaseLayout
	lang={lang}
	title={`${dict.explore.title} - ${dict.siteTitle}`}
	altPath={`/${lang === 'en' ? 'da' : 'en'}/${personSlug}/explore`}
>
	<main class="explore">
		<div class="explore-heading">
			<h1>{dict.explore.title}</h1>
			<a class="slideshow-link" href={`/${lang}/${personSlug}/slideshow`}>{dict.slideshow.navLink}</a>
		</div>
		<p class="non-map-alternative"><a href={`/${lang}/journal`}>{dict.explore.nonMapAlternative}</a></p>

		{/* The map island and the journal list share one wrapper so that, on
		    desktop, they can sit side by side with the map sticky (spec
		    section 6). Source order stays map first, list second - that is the
		    order a phone and a keyboard get. */}
		<div class="explore-body">
			<TimelineExplorer
				client:only="react"
				lang={lang}
				personSlug={personSlug}
				entries={explorerEntries}
				legs={explorerLegs}
				places={explorerPlaces}
				people={explorerPeople}
				labels={{
					previous: dict.entry.previous,
					next: dict.entry.next,
					openMap: dict.explore.openMap,
					closeMap: dict.explore.closeMap,
					crossingMarker: dict.explore.crossingMarker
				}}
			/>

			<div class="journal-list">
				{
					cards.length === 0 ? (
						<p>{dict.common.noEntries}</p>
					) : (
						cards.map((card) => (
							<a
								id={`entry-${card.id}`}
								class="journal-card"
								data-date={card.occurredAt}
								href={`/${lang}/${person.slug}/${card.slug}`}
							>
								{card.thumb && <img src={card.thumb} alt={card.thumbAlt} loading="lazy" />}
								<div class="journal-card-text">
									<time class="journal-card-date" datetime={card.occurredAt}>
										{card.dateLabel}
									</time>
									<h2>{card.title}</h2>
									{card.dek && <p>{card.dek}</p>}
								</div>
							</a>
						))
					)
				}
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	.explore {
		max-width: 64rem;
		margin: 0 auto;
		padding: var(--space-6) var(--grid-margin) var(--space-12);
	}

	.explore-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--text-h1);
		margin: 0 0 var(--space-2);
	}

	.slideshow-link {
		font-family: var(--font-sans);
		font-size: var(--text-ui);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		text-decoration: none;
		min-height: var(--touch-min);
		display: inline-flex;
		align-items: center;
		padding: 0 var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
	}

	.slideshow-link:hover {
		color: var(--color-link);
		border-color: var(--color-link);
	}

	.non-map-alternative {
		font-family: var(--font-sans);
		font-size: var(--text-ui);
		margin: 0 0 var(--space-4);
	}

	/* A full 44px target: the bare text link was only as tall as its own
	   line (16px). */
	.non-map-alternative a {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-min);
		color: var(--color-text-muted);
	}

	.journal-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin-top: var(--space-8);
		max-width: 34rem;
		min-width: 0;
	}

	/* Desktop: journal on the left, sticky map on the right (the island
	   places itself in the second column, see TimelineExplorer.css). The page
	   widens to the site's full content width to make room for both. */
	@media (min-width: 1024px) {
		.explore {
			max-width: var(--content-max);
		}

		.explore-body {
			display: grid;
			grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
			column-gap: var(--space-12);
			align-items: start;
		}

		.journal-list {
			grid-column: 1;
			grid-row: 1;
			margin-top: 0;
			max-width: none;
		}
	}

	.journal-card {
		display: flex;
		gap: var(--space-4);
		color: var(--color-text);
		text-decoration: none;
		padding: var(--space-4) 0;
		border-top: var(--border-hairline);
	}

	.journal-card img {
		width: 96px;
		height: 72px;
		object-fit: cover;
		flex-shrink: 0;
		border-radius: var(--radius-xs);
	}

	.journal-card-text {
		min-width: 0;
	}

	.journal-card-date {
		display: block;
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-1);
	}

	.journal-card h2 {
		font-family: var(--font-serif);
		font-size: var(--text-body);
		margin: 0 0 var(--space-1);
		overflow-wrap: anywhere;
	}

	.journal-card p {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text-muted);
	}
</style>
