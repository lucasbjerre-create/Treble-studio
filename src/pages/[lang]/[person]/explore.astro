---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TimelineExplorer from '../../../components/TimelineExplorer.tsx';
import { getDb } from '../../../db/client';
import {
	getPersonBySlug,
	listEntriesForViewer,
	listEntryTranslations,
	listLegsForViewer,
	listMediaForEntry,
	listPlacesForViewer
} from '../../../db/queries';
import { isLocale, t, type Locale } from '../../../i18n/t';
import { resolveEntryText } from '../../../lib/translation';

const { lang: rawLang, person: personSlug } = Astro.params;
if (!rawLang || !isLocale(rawLang) || !personSlug) {
	return new Response('Not found', { status: 404 });
}
const lang = rawLang as Locale;
const dict = t(lang);

const db = getDb();
const now = new Date().toISOString();

const person = await getPersonBySlug(db, 'public', personSlug);
if (!person) {
	return new Response('Not found', { status: 404 });
}

const entries = await listEntriesForViewer(db, 'public', now, { personId: person.id });
const legs = await listLegsForViewer(db, 'public', now);
const places = await listPlacesForViewer(db, 'public');

const translations = await listEntryTranslations(
	db,
	entries.map((e) => e.id),
	lang
);

const cards = await Promise.all(
	entries.map(async (entry) => {
		const resolved = resolveEntryText(
			{ originalLang: entry.originalLang, title: entry.title, dek: entry.dek, bodyMd: entry.bodyMd },
			translations.get(entry.id),
			lang
		);
		const media = await listMediaForEntry(db, 'public', entry.id, now);
		return {
			id: entry.id,
			slug: entry.slug,
			occurredAt: entry.occurredAt,
			title: resolved.title,
			dek: resolved.dek,
			thumb: media[0]?.keyThumb ?? null,
			thumbAlt: media[0]?.altText ?? ''
		};
	})
);

// timeline.ts is multi-person-ready, but this page still shows one person at
// a time - only this person's entries/legs are passed in. personId is
// threaded through because TimelineEntry/TimelineLeg now require it.
const explorerEntries = entries.map((e) => ({
	id: e.id,
	personId: e.personId,
	slug: e.slug,
	occurredAt: e.occurredAt,
	chapterId: e.chapterId,
	placeId: e.placeId
}));

const explorerLegs = legs.map((l) => ({
	id: l.id,
	personId: l.personId,
	fromPlaceId: l.fromPlaceId,
	toPlaceId: l.toPlaceId,
	startsAt: l.startsAt,
	endsAt: l.endsAt,
	mode: l.mode
}));

const explorerPlaces = places.map((p) => ({ id: p.id, label: p.label, latPublic: p.latPublic, lonPublic: p.lonPublic }));

// Only this page's own person for now (same single-person scope as
// explorerEntries/explorerLegs above) - keyed by id so TimelineExplorer can
// look up any personId it encounters, ready for when more than one person's
// entries are passed in together.
const explorerPeople = { [person.id]: { displayName: person.displayName, seat: person.seat } };
---

<BaseLayout
	lang={lang}
	title={`${dict.explore.title} - ${dict.siteTitle}`}
	altPath={`/${lang === 'en' ? 'da' : 'en'}/${personSlug}/explore`}
>
	<main class="explore">
		<h1>{dict.explore.title}</h1>
		<p class="non-map-alternative"><a href={`/${lang}/journal`}>{dict.explore.nonMapAlternative}</a></p>

		<TimelineExplorer
			client:only="react"
			entries={explorerEntries}
			legs={explorerLegs}
			places={explorerPlaces}
			people={explorerPeople}
			labels={{
				previous: dict.entry.previous,
				next: dict.entry.next,
				openMap: dict.explore.openMap,
				closeMap: dict.explore.closeMap
			}}
		/>

		<div class="journal-list">
			{
				cards.length === 0 ? (
					<p>{dict.common.noEntries}</p>
				) : (
					cards.map((card) => (
						<a
							id={`entry-${card.id}`}
							class="journal-card"
							data-date={card.occurredAt}
							href={`/${lang}/${person.slug}/${card.slug}`}
						>
							{card.thumb && <img src={card.thumb} alt={card.thumbAlt} loading="lazy" />}
							<div>
								<h2>{card.title}</h2>
								{card.dek && <p>{card.dek}</p>}
							</div>
						</a>
					))
				)
			}
		</div>
	</main>
</BaseLayout>

<style>
	.explore {
		max-width: 64rem;
		margin: 0 auto;
		padding: var(--space-6) var(--grid-margin) var(--space-12);
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--text-h1);
		margin: 0 0 var(--space-2);
	}

	.non-map-alternative {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		margin: 0 0 var(--space-6);
	}

	.non-map-alternative a {
		color: var(--color-text-muted);
	}

	.journal-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin-top: var(--space-8);
		max-width: 34rem;
	}

	.journal-card {
		display: flex;
		gap: var(--space-4);
		color: var(--color-text);
		text-decoration: none;
		padding: var(--space-4) 0;
		border-top: var(--border-hairline);
	}

	.journal-card img {
		width: 96px;
		height: 72px;
		object-fit: cover;
		flex-shrink: 0;
		border-radius: var(--radius-xs);
	}

	.journal-card h2 {
		font-family: var(--font-serif);
		font-size: var(--text-body);
		margin: 0 0 var(--space-1);
	}

	.journal-card p {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: var(--color-text-muted);
	}
</style>
