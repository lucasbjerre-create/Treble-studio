---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import {
	getPersonBySlug,
	listChaptersForPerson,
	listEntriesForViewer,
	listEntryTranslations,
	resolveViewerForPerson
} from '../../db/queries';
import { PRIMARY_PERSON_SLUG } from '../../config/site';
import { isLocale, t, type Locale } from '../../i18n/t';
import { formatEntryDay, formatMonthHeading } from '../../lib/entryDate';
import { groupEntriesByChapterAndMonth } from '../../lib/grouping';
import { resolveEntryText } from '../../lib/translation';

const { lang: rawLang } = Astro.params;
if (!rawLang || !isLocale(rawLang)) {
	return Astro.rewrite('/404');
}
const lang = rawLang as Locale;
const dict = t(lang);

const categoryParam = Astro.url.searchParams.get('category');
const category = categoryParam === 'life' || categoryParam === 'school' || categoryParam === 'trip' ? categoryParam : undefined;

const db = getDb();
const now = new Date().toISOString();

const person = await getPersonBySlug(db, 'public', PRIMARY_PERSON_SLUG);
if (!person) {
	return Astro.rewrite('/404');
}

const viewer = await resolveViewerForPerson(db, Astro.locals.viewerEmail, person.id);
const entries = await listEntriesForViewer(db, viewer, now, { personId: person.id, category });
const translations = await listEntryTranslations(
	db,
	entries.map((e) => e.id),
	lang
);
const entriesForDisplay = entries.map((entry) => ({
	...entry,
	displayTitle: resolveEntryText(
		{ originalLang: entry.originalLang, title: entry.title, dek: entry.dek, bodyMd: entry.bodyMd },
		translations.get(entry.id),
		lang
	).title
}));
const chapters = await listChaptersForPerson(db, person.id);
const chapterTitles = new Map(chapters.map((c) => [c.id, c.title]));
// chapterTitle is null for entries with no chapter (or one whose title is
// missing): those groups get no chapter heading at all, and their months
// step up to <h2> so the outline never skips a level under the page <h1>.
const groups = groupEntriesByChapterAndMonth(entriesForDisplay).map((group) => ({
	...group,
	chapterTitle: (group.chapterId !== null ? chapterTitles.get(group.chapterId) : undefined) || null
}));

const filters: Array<{ value: 'life' | 'school' | 'trip' | undefined; label: string }> = [
	{ value: undefined, label: dict.archive.filterAll },
	{ value: 'life', label: dict.archive.filterLife },
	{ value: 'school', label: dict.archive.filterSchool },
	{ value: 'trip', label: dict.archive.filterTrip }
];

function filterHref(value: 'life' | 'school' | 'trip' | undefined): string {
	return value ? `/${lang}/archive?category=${value}` : `/${lang}/archive`;
}
---

<BaseLayout lang={lang} title={`${dict.archive.title} - ${dict.siteTitle}`} altPath={`/${lang === 'en' ? 'da' : 'en'}/archive${category ? `?category=${category}` : ''}`}>
	<main class="archive">
		<h1>{dict.archive.title}</h1>

		<nav class="filters">
			{
				filters.map((f) => (
					<a href={filterHref(f.value)} aria-current={f.value === category ? 'page' : undefined}>
						{f.label}
					</a>
				))
			}
		</nav>

		{
			groups.length === 0 ? (
				<p>{dict.common.noEntries}</p>
			) : (
				groups.map((group) => (
					<section class="chapter-group">
						{group.chapterTitle && <h2 class="chapter-heading">{group.chapterTitle}</h2>}
						{group.months.map((month) => (
							<div class="month-group">
								{group.chapterTitle ? (
									<h3 class="month-heading">{formatMonthHeading(month.year, month.month, lang)}</h3>
								) : (
									<h2 class="month-heading">{formatMonthHeading(month.year, month.month, lang)}</h2>
								)}
								<ul>
									{month.entries.map((entry) => (
										<li>
											<a href={`/${lang}/${person.slug}/${entry.slug}`}>
												<time class="day" datetime={entry.occurredAt}>{formatEntryDay(entry.occurredAt, entry.timezone, lang)}</time>
												<span class="title">{entry.displayTitle}</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</section>
				))
			)
		}
	</main>
</BaseLayout>

<style>
	.archive {
		max-width: 38rem;
		margin: 0 auto;
		padding: var(--space-6) var(--grid-margin) var(--space-12);
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--text-h1);
		margin: 0 0 var(--space-6);
	}

	/* Each filter is a target at least 44px wide with its word centred in it,
	   so the gap between them is smaller than it was between the bare words. */
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-8);
		font-family: var(--font-sans);
		font-size: var(--text-small);
	}

	.filters a {
		color: var(--color-text-muted);
		text-decoration: none;
		min-height: var(--touch-min);
		min-width: var(--touch-min);
		display: flex;
		align-items: center;
		justify-content: center;
		white-space: nowrap;
	}

	.filters a:hover,
	.filters a[aria-current='page'] {
		color: var(--color-text);
	}

	.filters a[aria-current='page'] {
		font-weight: var(--weight-semibold);
	}

	.chapter-group {
		margin-bottom: var(--space-8);
	}

	.chapter-heading {
		font-family: var(--font-serif);
		font-size: var(--text-h3);
		margin: 0 0 var(--space-4);
	}

	/* A month is an <h3> under a chapter heading and an <h2> when there is
	   none, so its whole look is set here instead of coming from the tag. */
	.month-heading {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-h3);
		letter-spacing: var(--tracking-h3);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-2);
	}

	.month-group ul {
		list-style: none;
		margin: 0 0 var(--space-4);
		padding: 0;
	}

	/* Day and title share a baseline. The padding, not the min-height, is what
	   keeps a one-line row above 44px, and a long title wraps beside the day
	   instead of under it. */
	.month-group li a {
		font-family: var(--font-serif);
		font-size: var(--text-body);
		color: var(--color-text);
		text-decoration: none;
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		min-height: var(--touch-min);
		padding: var(--space-3) 0;
	}

	.month-group li a:hover {
		color: var(--color-link);
	}

	/* Fixed-width column so titles line up down the list in both languages
	   ("30. sep." is the widest day). */
	.day {
		flex: none;
		min-width: var(--space-16);
		font-family: var(--font-sans);
		font-size: var(--text-small);
		font-variant-numeric: tabular-nums;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.title {
		min-width: 0;
		overflow-wrap: anywhere;
	}
</style>
