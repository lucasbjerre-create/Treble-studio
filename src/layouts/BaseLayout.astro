---
import '../styles/tokens.css';
import Logo from '../components/Logo.astro';
import { SITE_URL } from '../config/site';
import { t, type Locale } from '../i18n/t';

interface Props {
	lang: Locale;
	title: string;
	/** Path (with any query string) for this same page in the other language. Defaults to that language's homepage. */
	altPath?: string;
	/** Link-preview description (og:description/twitter:description). Keep this to a public-safe dek/summary - never raw body text, never coordinates (privacy.md). */
	description?: string;
	/** This page's own path (e.g. `/en/lucas/weekend-in-asheville`), for og:url and the RSS/sitemap canonical link. Defaults to no og:url (the homepage doesn't need one). */
	canonicalPath?: string;
	/** False leaves out every link-preview tag (og:*, twitter:*). The 404 page sets this: an address that has no page, or a private entry answering as if it had none, must carry nothing to preview (tests/e2e/privacy.spec.ts). */
	linkPreview?: boolean;
}

const { lang, title, altPath, description, canonicalPath, linkPreview = true } = Astro.props;
const dict = t(lang);
const otherLang: Locale = lang === 'en' ? 'da' : 'en';
const otherLangHref = altPath ?? `/${otherLang}/`;
const year = new Date().getFullYear();
const canonicalUrl = canonicalPath ? `${SITE_URL}${canonicalPath}` : undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{linkPreview && <meta property="og:image" content={`${SITE_URL}/og-image.png`} />}
		{linkPreview && <meta property="og:title" content={title} />}
		{linkPreview && <meta property="og:type" content="website" />}
		{linkPreview && description && <meta property="og:description" content={description} />}
		{linkPreview && canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{linkPreview && <meta name="twitter:card" content="summary_large_image" />}
		{linkPreview && <meta name="twitter:title" content={title} />}
		{linkPreview && description && <meta name="twitter:description" content={description} />}
		<link rel="alternate" type="application/rss+xml" title={dict.siteTitle} href={`/${lang}/rss.xml`} />
		<meta name="theme-color" content="#F4F2ED" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#10142A" media="(prefers-color-scheme: dark)" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-title" href={`/${lang}/`} aria-label={dict.siteTitle}>
				<span class="site-title-logo site-title-logo--wide">
					<Logo variant="lockup" alt={dict.siteTitle} height="1.5rem" />
				</span>
				<span class="site-title-logo site-title-logo--narrow">
					<Logo variant="mark" alt={dict.siteTitle} height="1.5rem" />
				</span>
			</a>
			<nav>
				<a href={`/${lang}/journal`}>{dict.nav.journal}</a>
				<a href={`/${lang}/archive`}>{dict.nav.archive}</a>
				<a href={`/${lang}/explore`}>{dict.nav.explore}</a>
				<a class="lang-toggle" href={otherLangHref} lang={otherLang} hreflang={otherLang}>{dict.languageToggle[otherLang]}</a>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<span class="footer-logo">
				<Logo variant="descriptor" alt={dict.siteTitle} height="1.25rem" />
			</span>
			<p class="t-eyebrow footer-note">&copy; {year}</p>
		</footer>
	</body>
</html>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: var(--nav-height);
		padding: 0 var(--grid-margin);
		border-bottom: var(--border-hairline);
		background: var(--color-bg);
		position: sticky;
		top: 0;
		z-index: var(--z-nav);
	}

	/* On a phone the mark alone is about 30px wide, so the link is padded out
	   to a full 44px target with the mark centred in it. */
	.site-title {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: var(--touch-min);
		min-width: var(--touch-min);
		text-decoration: none;
	}

	.site-title-logo {
		height: 1.5rem;
	}

	.site-title-logo--wide {
		display: none;
	}

	@media (min-width: 480px) {
		.site-title-logo--wide {
			display: inline-flex;
		}
		.site-title-logo--narrow {
			display: none;
		}
	}

	/* The narrow gap is what keeps the mark, three links and the language pill
	   on one row at 375px: about 326px of the 343px available in English and
	   324px in Danish. The wide gap starts at 520px, not at the 480px where the
	   logo becomes the lockup, because lockup plus wide gap needs about 461px
	   and a 480px screen only has 448px. */
	nav {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		font-family: var(--font-sans);
		font-size: var(--text-ui);
	}

	@media (min-width: 520px) {
		nav {
			gap: var(--space-5);
		}
	}

	/* The narrowest phones get one step less gap and one step smaller text,
	   which keeps the header on one row from 336px up. At 320px it takes two
	   rows, as it did before the links grew. */
	@media (max-width: 359px) {
		nav {
			gap: var(--space-2);
			font-size: var(--text-small);
		}
	}

	nav a {
		color: var(--color-text);
		text-decoration: none;
		min-height: var(--touch-min);
		min-width: var(--touch-min);
		display: flex;
		align-items: center;
		justify-content: center;
		white-space: nowrap;
	}

	nav a:hover {
		color: var(--color-link);
	}

	.lang-toggle {
		font-weight: var(--weight-medium);
		padding: 0 var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		min-height: 2rem;
	}

	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		max-width: var(--content-max);
		margin: var(--space-16) auto 0;
		padding: var(--space-6) var(--grid-margin) var(--space-12);
		border-top: var(--border-hairline);
	}

	.footer-logo {
		height: 1.25rem;
		opacity: 0.85;
	}

	.footer-note {
		margin: 0;
	}
</style>
