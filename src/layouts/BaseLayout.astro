---
import '../styles/tokens.css';
import Logo from '../components/Logo.astro';
import { SITE_URL } from '../config/site';
import { t, type Locale } from '../i18n/t';

interface Props {
	lang: Locale;
	title: string;
	/** Path (with any query string) for this same page in the other language. Defaults to that language's homepage. */
	altPath?: string;
}

const { lang, title, altPath } = Astro.props;
const dict = t(lang);
const otherLang: Locale = lang === 'en' ? 'da' : 'en';
const otherLangHref = altPath ?? `/${otherLang}/`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:image" content={`${SITE_URL}/og-image.png`} />
		<meta name="theme-color" content="#F4F2ED" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#10142A" media="(prefers-color-scheme: dark)" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-title" href={`/${lang}/`} aria-label={dict.siteTitle}>
				<span class="site-title-logo site-title-logo--wide">
					<Logo variant="lockup" alt={dict.siteTitle} height="1.5rem" />
				</span>
				<span class="site-title-logo site-title-logo--narrow">
					<Logo variant="mark" alt={dict.siteTitle} height="1.5rem" />
				</span>
			</a>
			<nav>
				<a href={`/${lang}/journal`}>{dict.nav.journal}</a>
				<a href={`/${lang}/archive`}>{dict.nav.archive}</a>
				<a href={`/${lang}/explore`}>{dict.nav.explore}</a>
				<a class="lang-toggle" href={otherLangHref} lang={otherLang} hreflang={otherLang}>{dict.languageToggle[otherLang]}</a>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<span class="footer-logo">
				<Logo variant="descriptor" alt={dict.siteTitle} height="1.25rem" />
			</span>
			<p class="t-eyebrow footer-note">&copy; {year}</p>
		</footer>
	</body>
</html>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: var(--nav-height);
		padding: 0 var(--grid-margin);
		border-bottom: var(--border-hairline);
		background: var(--color-bg);
		position: sticky;
		top: 0;
		z-index: var(--z-nav);
	}

	.site-title {
		display: flex;
		align-items: center;
		min-height: var(--touch-min);
		text-decoration: none;
	}

	.site-title-logo {
		height: 1.5rem;
	}

	.site-title-logo--wide {
		display: none;
	}

	@media (min-width: 480px) {
		.site-title-logo--wide {
			display: inline-flex;
		}
		.site-title-logo--narrow {
			display: none;
		}
	}

	nav {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		font-family: var(--font-sans);
		font-size: var(--text-small);
	}

	nav a {
		color: var(--color-text);
		text-decoration: none;
		min-height: var(--touch-min);
		display: flex;
		align-items: center;
	}

	nav a:hover {
		color: var(--color-link);
	}

	.lang-toggle {
		font-weight: var(--weight-medium);
		padding: 0 var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		min-height: 2rem;
	}

	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		max-width: var(--content-max);
		margin: var(--space-16) auto 0;
		padding: var(--space-6) var(--grid-margin) var(--space-12);
		border-top: var(--border-hairline);
	}

	.footer-logo {
		height: 1.25rem;
		opacity: 0.85;
	}

	.footer-note {
		margin: 0;
	}
</style>
