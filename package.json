{
  "name": "exchange-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply exchange-site-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply exchange-site-db --remote",
    "db:seed": "wrangler d1 execute exchange-site-db --local --file=./src/db/seed.sql",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@turf/distance": "^7.4.0",
    "@turf/great-circle": "^7.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "maplibre-gl": "^6.15.0",
    "pica": "^10.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tz-lookup": "^6.1.25",
    "wrangler": "^4.152.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/tz-lookup": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
